# ---- Meta Graph API (required) ----
META_ACCESS_TOKEN=PASTE_YOUR_SYSTEM_USER_TOKEN
GRAPH_VERSION=v23.0

# ---- Server ----
PORT=3000
# HOST=127.0.0.1        # leave unset locally; hosting sets NODE_ENV=production and binds 0.0.0.0
# NODE_ENV=production
DASHBOARD_USER=reechd
DASHBOARD_PASSWORD=

# ---- Claude Weekly Intelligence ----
# Get a key at https://console.anthropic.com — required for the weekly AI analysis feature.
ANTHROPIC_API_KEY=
# Check https://docs.claude.com for current model IDs; override here without touching code.
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# ---- Optional: email the weekly report ----
# Leave SMTP_HOST / REPORT_EMAIL_TO blank to skip emailing (report still shows in the dashboard).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
